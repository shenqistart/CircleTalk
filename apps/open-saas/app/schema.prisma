datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  email    String? @unique
  username String? @unique
  isAdmin  Boolean @default(false)

  paymentProcessorUserId        String?   @unique
  lemonSqueezyCustomerPortalUrl String? // You can delete this if you're not using Lemon Squeezy as your payments processor.
  subscriptionStatus            String? // 'active', 'cancel_at_period_end', 'past_due', 'deleted'
  subscriptionPlan              String? // 'hobby', 'pro'
  datePaid                      DateTime?
  credits                       Int       @default(3)

  gptResponses         GptResponse[]
  contactFormMessages  ContactFormMessage[]
  tasks                Task[]
  files                File[]
  roundtableSessions   RoundtableSession[]
  roundtableUsages     RoundtableUsage[]
  paymentWebhookEvents PaymentWebhookEvent[]
  paymentOrders        PaymentOrder[]
}

model GptResponse {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id])
  userId String

  content String
}

model Task {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id])
  userId String

  description String
  time        String  @default("1")
  isDone      Boolean @default(false)
}

model File {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id])
  userId String

  name  String
  type  String
  s3Key String
}

model DailyStats {
  id   Int      @id @default(autoincrement())
  date DateTime @unique @default(now())

  totalViews                Int    @default(0)
  prevDayViewsChangePercent String @default("0")
  userCount                 Int    @default(0)
  paidUserCount             Int    @default(0)
  userDelta                 Int    @default(0)
  paidUserDelta             Int    @default(0)
  totalRevenue              Float  @default(0)
  totalProfit               Float  @default(0)

  sources PageViewSource[]
}

model PageViewSource {
  name String
  date DateTime @default(now())

  dailyStats   DailyStats? @relation(fields: [dailyStatsId], references: [id])
  dailyStatsId Int?

  visitors Int

  @@id([date, name])
}

model Logs {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())

  message String
  level   String
}

model ContactFormMessage {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id])
  userId String

  content   String
  isRead    Boolean   @default(false)
  repliedAt DateTime?
}

model RoundtablePersona {
  id        String   @id
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  skillName    String
  displayName  String
  sourceUrl    String?
  summary      String
  promptJson   Json
  metadataJson Json

  selectedInSessions RoundtableSessionPersona[]
  messages           RoundtableMessage[]

  @@index([displayName])
}

model RoundtableSession {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  decisionPrompt String
  language       String    @default("zh")
  status         String    @default("ready")
  metadataJson   Json
  expiresAt      DateTime?

  selectedPersonas RoundtableSessionPersona[]
  messages         RoundtableMessage[]
  artifacts        RoundtableArtifact[]
  usages           RoundtableUsage[]

  @@index([userId, createdAt])
  @@index([userId, status])
}

model RoundtableSessionPersona {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  session   RoundtableSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sessionId String

  persona   RoundtablePersona @relation(fields: [personaId], references: [id])
  personaId String

  selectionSource String
  selectionReason String?
  sequence        Int

  @@unique([sessionId, personaId])
  @@index([sessionId, sequence])
}

model RoundtableMessage {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  session   RoundtableSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sessionId String

  persona   RoundtablePersona? @relation(fields: [personaId], references: [id])
  personaId String?

  role            String
  roundName       String
  parentMessageId String?
  content         String
  sequence        Int

  @@index([sessionId, sequence])
}

model RoundtableArtifact {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  session   RoundtableSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sessionId String

  memo           String
  recommendation String
  reasonsJson    Json
  debateMapJson  Json
  metadataJson   Json

  @@index([sessionId, createdAt])
}

model RoundtableUsage {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  session   RoundtableSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sessionId String

  operation         String
  idempotencyKey    String    @unique
  status            String
  reservedAt        DateTime?
  completedAt       DateTime?
  cancelledAt       DateTime?
  errorAt           DateTime?
  recoveryAfter     DateTime?
  workerRequestId   String?
  streamTokenNonce  String?
  creditDebitAmount Int       @default(0)
  errorMessage      String?
  metadataJson      Json

  @@index([status, recoveryAfter])
  @@index([sessionId, status])
  @@index([userId, createdAt])
  @@index([workerRequestId])
}

model PaymentWebhookEvent {
  id          String   @id @default(uuid())
  createdAt   DateTime @default(now())
  processedAt DateTime @default(now())

  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId String?

  provider     String
  eventId      String @unique
  eventType    String
  metadataJson Json?

  @@index([provider, eventType])
  @@index([processedAt])
}

model PaymentOrder {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  provider        String
  planId          String
  outTradeNo      String    @unique
  checkoutToken   String    @unique
  providerTradeNo String?
  amountCents     Int
  currency        String    @default("CNY")
  status          String    @default("pending")
  paidAt          DateTime?
  rawNotifyJson   Json?

  @@index([userId, createdAt])
  @@index([provider, status])
  @@index([providerTradeNo])
}
