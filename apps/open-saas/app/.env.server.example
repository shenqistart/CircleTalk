# CircleTalk Wasp server env example.
# Placeholder values only. Do not commit real secrets.

NODE_ENV=development
WASP_SERVER_URL=http://localhost:3001
WASP_WEB_CLIENT_URL=http://localhost:3000
JWT_SECRET=replace-with-a-long-random-secret
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/bedrock

# Google OAuth
GOOGLE_CLIENT_ID=replace-with-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret

# Payments
PAYMENT_PROVIDER=zpay
ZPAY_PID=replace-with-zpay-merchant-id
ZPAY_KEY=replace-with-zpay-merchant-key
ZPAY_SUBMIT_URL=https://zpayz.cn/submit.php
ZPAY_API_URL=https://zpayz.cn/api.php
ZPAY_NOTIFY_URL=https://your-server.example.com/payments/zpay/notify
ZPAY_RETURN_URL=https://your-app.example.com/checkout
PAYMENTS_CREDITS_10_AMOUNT_CNY=9.90

# Optional Stripe fallback, only required when PAYMENT_PROVIDER=stripe.
STRIPE_API_KEY=sk_test_replace_me_optional
STRIPE_WEBHOOK_SECRET=whsec_replace_me_optional
PAYMENTS_HOBBY_SUBSCRIPTION_PLAN_ID=price_replace_hobby_optional
PAYMENTS_PRO_SUBSCRIPTION_PLAN_ID=price_replace_pro_optional
PAYMENTS_CREDITS_10_PLAN_ID=price_replace_credits10_optional

# Admin bootstrap
ADMIN_EMAILS=admin@example.com

# Private FastAPI AI Worker
AI_WORKER_URL=http://localhost:8000
AI_WORKER_SHARED_SECRET=replace-with-a-long-random-shared-secret
ROUNDTABLE_STREAM_TOKEN_SECRET=replace-with-a-different-long-random-secret

# Optional analytics/integrations
PLAUSIBLE_API_KEY=
PLAUSIBLE_SITE_ID=
PLAUSIBLE_BASE_URL=https://plausible.io/api
GOOGLE_ANALYTICS_CLIENT_EMAIL=
GOOGLE_ANALYTICS_PRIVATE_KEY=
GOOGLE_ANALYTICS_PROPERTY_ID=
AWS_S3_IAM_ACCESS_KEY=
AWS_S3_IAM_SECRET_KEY=
AWS_S3_FILES_BUCKET=
AWS_S3_REGION=
