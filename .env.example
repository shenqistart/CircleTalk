# Frontend
# Leave empty in local Vite dev to use /api proxy.
VITE_API_BASE_URL=

# Backend / database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/bedrock

# Optional roundtable LLM generation.
# Leave disabled for deterministic local fallback.
ROUNDTABLE_LLM_ENABLED=false
ROUNDTABLE_LLM_MODEL=
ROUNDTABLE_LLM_API_KEY=
# Optional for OpenAI-compatible providers such as DashScope, DeepSeek, Volcengine, etc.
ROUNDTABLE_LLM_BASE_URL=
ROUNDTABLE_LLM_TEMPERATURE=0.7
ROUNDTABLE_LLM_MAX_TOKENS=700
ROUNDTABLE_LLM_TIMEOUT=30
